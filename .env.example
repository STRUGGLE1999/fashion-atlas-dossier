# Gemini-compatible relay. The Google GenAI SDK appends
# /v1beta/models/{GEMINI_MODEL}:generateContent to this base URL.
GEMINI_BASE_URL="https://api.aicodemirror.ai/api/gemini"

# Paste the key and model ID issued by the relay.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.7-flash"

# Milliseconds before a model call falls back to the on-site curator answer.
AI_REQUEST_TIMEOUT_MS="30000"

# Optional. Neon Postgres for persisted moodboards and daily news curations.
# Leave empty to use in-memory fallbacks.
DATABASE_URL=""

# Optional. If set, /api/cron/fetch-fashion-news requires Authorization: Bearer ...
CRON_SECRET=""

# GitHub Actions (repository secrets, not environment secrets):
# Settings → Secrets and variables → Actions → New repository secret
#   GEMINI_API_KEY     = the same key as above
#   GEMINI_BASE_URL    = https://api.aicodemirror.ai/api/gemini
#   GEMINI_MODEL       = gemini-3.7-flash
